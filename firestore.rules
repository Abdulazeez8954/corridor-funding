rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    match /applications/{appId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /documents/{docId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /stateProducts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /chats/{userId}/messages/{msgId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}